// Place your settings in this file to overwrite default and user settings.
{
  // Configure glob patterns for excluding files and folders in the file explorer.
  "files.exclude": {
    "**/.git": true,
    "**/.DS_Store": true,
    "**/bower_components": true,
    "**/coverage": true,
    "**/jest-output": true,
    "**/lib-amd": true,
    "src/**/*.scss.ts": true
  },
  "typescript.tsdk": ".\\node_modules\\typescript\\lib",
  "cloude-code-toolbox.thinkingMachineMode.enabled": false,
  "cloude-code-toolbox.thinkingMachineMode.runAwarenessScan": true,
  "cloude-code-toolbox.thinkingMachineMode.mergeAwarenessIntoClaudeMd": true,
  "cloude-code-toolbox.thinkingMachineMode.showConfirmationModal": true,
  "cloude-code-toolbox.thinkingMachineMode.useSeparateContextPackDefaults": true,
  "cloude-code-toolbox.thinkingMachineMode.includeGit": true,
  "cloude-code-toolbox.thinkingMachineMode.includeDiagnostics": true,
  "cloude-code-toolbox.thinkingMachineMode.appendNotepad": true,
  "cloude-code-toolbox.thinkingMachineMode.openChat": true,
  "cloude-code-toolbox.intelligence.autoScanMcpSkillsOnWorkspaceOpen": true
}